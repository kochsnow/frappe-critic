{
  "doctype": "DocType",
  "name": "Critic Finding",
  "module": "Frappe Critic",
  "field_order": [
    "audit_log",
    "app",
    "file_path",
    "line_start",
    "line_end",
    "rule_id",
    "severity",
    "category",
    "message",
    "code_snippet",
    "source_sha256",
    "remediation_status",
    "latest_remediation_task",
    "ai_section",
    "ai_status",
    "ai_model",
    "ai_explanation",
    "ai_fix",
    "ai_patch",
    "ai_error",
    "ai_response"
  ],
  "fields": [
    {
      "fieldname": "audit_log",
      "fieldtype": "Link",
      "label": "Audit Log",
      "options": "Critic Audit Log",
      "reqd": 1
    },
    {
      "fieldname": "app",
      "fieldtype": "Data",
      "label": "App",
      "reqd": 1
    },
    {
      "fieldname": "file_path",
      "fieldtype": "Data",
      "label": "File Path",
      "length": 512,
      "reqd": 1
    },
    {
      "fieldname": "line_start",
      "fieldtype": "Int",
      "label": "Line Start",
      "reqd": 1
    },
    {
      "fieldname": "line_end",
      "fieldtype": "Int",
      "label": "Line End",
      "reqd": 1
    },
    {
      "fieldname": "rule_id",
      "fieldtype": "Data",
      "label": "Rule ID"
    },
    {
      "fieldname": "severity",
      "fieldtype": "Select",
      "label": "Severity",
      "options": "Critical\nHigh\nMedium\nLow\nInfo",
      "default": "Info"
    },
    {
      "fieldname": "category",
      "fieldtype": "Data",
      "label": "Category"
    },
    {
      "fieldname": "message",
      "fieldtype": "Text",
      "label": "Message"
    },
    {
      "fieldname": "code_snippet",
      "fieldtype": "Code",
      "label": "Code Snippet"
    },
    {
      "fieldname": "source_sha256",
      "fieldtype": "Data",
      "label": "Source SHA-256",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "remediation_status",
      "fieldtype": "Select",
      "label": "Remediation Status",
      "options": "NotPrepared\nPreparing\nReady\nFailed",
      "default": "NotPrepared",
      "read_only": 1
    },
    {
      "fieldname": "latest_remediation_task",
      "fieldtype": "Link",
      "label": "Latest Remediation Task",
      "options": "Critic Remediation Task",
      "read_only": 1
    },
    {
      "fieldname": "ai_section",
      "fieldtype": "Section Break",
      "label": "AI Fix Preview"
    },
    {
      "fieldname": "ai_status",
      "fieldtype": "Select",
      "label": "AI Status",
      "options": "NotRequested\nPreviewed\nRequested\nDone\nFailed",
      "default": "NotRequested"
    },
    {
      "fieldname": "ai_model",
      "fieldtype": "Data",
      "label": "AI Model",
      "read_only": 1
    },
    {
      "fieldname": "ai_explanation",
      "fieldtype": "Text",
      "label": "AI Explanation",
      "read_only": 1
    },
    {
      "fieldname": "ai_fix",
      "fieldtype": "Code",
      "label": "Corrected Code Preview",
      "read_only": 1
    },
    {
      "fieldname": "ai_patch",
      "fieldtype": "Code",
      "label": "Unified Diff Preview",
      "read_only": 1
    },
    {
      "fieldname": "ai_error",
      "fieldtype": "Text",
      "label": "AI Error",
      "read_only": 1
    },
    {
      "fieldname": "ai_response",
      "fieldtype": "Text",
      "label": "Raw AI Response",
      "read_only": 1,
      "hidden": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
