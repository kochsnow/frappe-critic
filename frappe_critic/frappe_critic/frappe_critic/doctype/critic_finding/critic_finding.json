      "options": "Critical\nHigh\nMedium\nLow\nInfo",
      "default": "Info"
    },
    {
      "fieldname": "category",
      "fieldtype": "Data",
      "label": "Category"
    },
    {
      "fieldname": "message",
      "fieldtype": "Text",
      "label": "Message"
    },
    {
      "fieldname": "code_snippet",
      "fieldtype": "Code",
      "label": "Code Snippet"
    },
    {
