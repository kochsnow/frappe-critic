    {
      "fieldname": "app",
      "fieldtype": "Data",
      "label": "App",
      "reqd": 1
    },
    {
      "fieldname": "file_path",
      "fieldtype": "Data",
      "label": "File Path",
      "length": 512,
      "reqd": 1
    },
    {
      "fieldname": "line_start",
      "fieldtype": "Int",
      "label": "Line Start",
      "reqd": 1
    },
    {
      "fieldname": "line_end",
      "fieldtype": "Int",
      "label": "Line End",
      "reqd": 1
    },
    {
      "fieldname": "rule_id",
      "fieldtype": "Data",
      "label": "Rule ID"
    },
    {
